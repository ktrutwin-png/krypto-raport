<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<title>Erl.grey83 · On your path, other people's maps won't work</title>
<meta name="description" content="Crypto, gold and awareness. Pure information, every day. Live prices and three things worth knowing today. Not financial advice.">
<meta property="og:title" content="Erl.grey83">
<meta property="og:description" content="On your path, other people's maps won't work. Crypto, gold and awareness – pure information, every day.">
<meta property="og:image" content="https://erlgrey83-crypto-freaq.vercel.app/assets/hexa_og.jpg">
<meta property="og:type" content="website">
<meta name="twitter:card" content="summary_large_image">
<meta name="theme-color" content="#0b0b0d">
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 400 400'%3E%3Crect width='400' height='400' rx='80' fill='%230b0b0d'/%3E%3Cpath d='M 322 116 A 150 150 0 1 0 338 182' fill='none' stroke='%23d9d6cf' stroke-width='44' stroke-linecap='round'/%3E%3Cpath d='M120 262 L292 138' stroke='%23c9a54a' stroke-width='46' stroke-linecap='round'/%3E%3C/svg%3E">
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;700&family=Cormorant+Garamond:ital,wght@0,500;1,500&display=swap">
<link rel="preload" as="image" href="assets/hexa.webp" media="(min-width:821px)">
<style>
:root{--bg:#0b0b0d;--fg:#d9d6cf;--hi:#f1eee7;--mut:#b9b5ac;--dim:#a8a49b;--gold:#c9a54a;--paper:#efe9dd;--line:#26252a;--serif:'Cormorant Garamond',Georgia,serif}
*{box-sizing:border-box;margin:0}
html{scroll-behavior:smooth;overflow-x:clip;accent-color:var(--gold);scrollbar-color:#3a372f var(--bg)}
body{background:var(--bg);color:var(--fg);font-family:'Space Grotesk',system-ui,sans-serif;line-height:1.6;overflow-x:clip}
::selection{background:var(--gold);color:var(--bg)}
:focus-visible{outline:2px solid var(--gold);outline-offset:4px;border-radius:6px}
a{color:var(--gold)}a:hover{color:#ead18a}
.wrap{width:100%;max-width:1240px;margin:0 auto;padding-left:32px;padding-right:32px}

.hero{min-height:min(100svh,820px);display:flex;flex-direction:column;background-image:linear-gradient(180deg,rgba(11,11,13,.55) 0%,rgba(11,11,13,.15) 35%,rgba(11,11,13,.92) 88%,#0b0b0d 100%),url(assets/hexa.webp);background-size:cover;background-position:center 22%}
.top{padding-top:28px;padding-bottom:28px;display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:12px 20px}
.brand{display:flex;align-items:center;gap:14px;font-weight:300;font-size:20px;letter-spacing:8px;color:var(--hi);text-decoration:none}
.brand:hover{color:var(--hi)}
.bb{font-size:11px;letter-spacing:.18em;text-transform:uppercase;color:var(--gold);border:1px solid rgba(201,165,74,.5);border-radius:99px;padding:3px 10px;margin-left:4px;font-weight:500;white-space:nowrap}.brand:hover .bb{background:var(--gold);color:var(--bg)}
.top nav{display:flex;flex-wrap:wrap;gap:26px;font-size:14px;letter-spacing:2px;text-transform:uppercase}
.top nav a{color:var(--hi);text-decoration:none;padding:12px 0;border-bottom:1px solid transparent}
.top nav a:hover{border-bottom-color:var(--gold)}
.hero-in{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:flex-end;text-align:center;gap:22px;padding:60px 24px 72px}
h1{font-family:var(--serif);font-weight:500;font-size:clamp(38px,6.2vw,76px);line-height:1.05;color:#f8f5ee;max-width:900px;text-wrap:balance}
.hero-in p{font-size:clamp(16px,1.6vw,19px);color:var(--fg);max-width:620px}
.cta{display:inline-block;padding:16px 34px;border-radius:999px;background:var(--gold);color:var(--bg);font-weight:700;letter-spacing:2px;text-transform:uppercase;font-size:14px;text-decoration:none;transition:background .2s}
.cta:hover{background:#ead18a;color:var(--bg)}

.strip{border-top:1px solid #2a2622;border-bottom:1px solid #2a2622;background:#0f0f11}
.strip .wrap{padding-top:22px;padding-bottom:22px;display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:18px}
.q{display:flex;align-items:baseline;gap:12px;white-space:nowrap}
.q .s{font-size:13px;letter-spacing:3px;color:var(--dim)}
.q .p{font-size:22px;font-weight:500;color:var(--hi);font-variant-numeric:tabular-nums}
.q.au .p{color:var(--gold)}
.q .c{font-size:14px;color:var(--mut);font-variant-numeric:tabular-nums}
.q .c.up{color:#a9c9a4}.q .c.dn{color:#d59a94}

.dzis{padding-top:84px;padding-bottom:84px;display:flex;flex-wrap:wrap;gap:56px}
.dzis .l{flex:1 1 300px;min-width:0;display:flex;flex-direction:column;gap:16px}
.eyebrow{font-size:13px;letter-spacing:5px;text-transform:uppercase;color:var(--gold)}
h2{font-family:var(--serif);font-weight:500;font-size:clamp(34px,4vw,48px);line-height:1.1;color:var(--hi);text-wrap:balance}
.neon{width:64px;height:2px;background:linear-gradient(90deg,#38bdf8,#a78bfa)}
.upd{font-size:13px;letter-spacing:1px;color:#8f8b83}
.dzis .r{flex:999 1 560px;min-width:0;display:flex;flex-direction:column}
.dzis article{padding:28px 0;border-bottom:1px solid var(--line);display:flex;gap:24px}
.dzis article:last-child{border-bottom:0}
.n{font-family:var(--serif);font-size:44px;line-height:1;color:var(--dim);min-width:22px}
.dzis article:first-child .n{color:var(--gold)}
.dzis h3{font-weight:500;font-size:clamp(20px,2.2vw,24px);line-height:1.3;color:var(--hi);margin-bottom:8px}
.dzis article p{font-size:17px;color:var(--mut)}
.dzis article b{color:var(--hi);font-weight:500}

.pyt{background:var(--paper);color:#1b1a1d}
.pyt div{max-width:900px;margin:0 auto;padding:84px 32px;display:flex;flex-direction:column;align-items:center;text-align:center;gap:20px}
.pyt .eyebrow{color:#6b5a2a}
.pyt p{font-family:var(--serif);font-style:italic;font-size:clamp(28px,3.6vw,40px);line-height:1.25;text-wrap:balance}

footer{padding-top:44px;padding-bottom:44px;display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:16px}
footer .b{font-weight:300;font-size:16px;letter-spacing:6px}
footer .t{font-size:13px;letter-spacing:2px;text-transform:uppercase;color:#8f8b83}
footer .t a{color:#8f8b83;text-decoration:none}footer .t a:hover{color:var(--gold)}

.rv{opacity:0;transform:translateY(18px);transition:opacity .8s ease,transform .8s ease}.rv.in{opacity:1;transform:none}
@media(max-width:820px){.wrap{padding-left:20px;padding-right:20px}.hero{background-image:linear-gradient(180deg,rgba(11,11,13,.55) 0%,rgba(11,11,13,.15) 30%,rgba(11,11,13,.92) 82%,#0b0b0d 100%),url(assets/hexa_m.webp);background-position:center top;min-height:min(100svh,760px)}
 .brand{font-size:16px;letter-spacing:6px}.top{justify-content:center}.top nav{gap:20px;font-size:13px}.hero-in{padding:40px 20px 56px}
 .strip .wrap{grid-template-columns:1fr 1fr;gap:14px 10px}.q{gap:8px;flex-wrap:wrap}.q .p{font-size:19px}
 .dzis{padding-top:56px;padding-bottom:56px;gap:28px}.dzis article{gap:18px}.pyt div{padding:60px 22px}footer{justify-content:center;text-align:center}}
@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}.rv{opacity:1;transform:none;transition:none}.cta{transition:none}}
</style>
</head>
<body>
<section class="hero">
  <header class="wrap top">
    <a class="brand" href="/brain/" aria-label="Erl.grey83 – how our AI system works">
      <svg width="42" height="42" viewBox="0 0 400 400" aria-hidden="true"><path d="M 322 116 A 150 150 0 1 0 338 182" fill="none" stroke="#f1eee7" stroke-width="24" stroke-linecap="round"/><polygon points="200,116 273,158 273,242 200,284 127,242 127,158" fill="none" stroke="#f1eee7" stroke-width="12" stroke-linejoin="round"/><polyline points="108,266 166,216 204,238 292,138" fill="none" stroke="#c9a54a" stroke-width="16" stroke-linecap="round" stroke-linejoin="round"/></svg>
      ERL.GREY83<span class="bb">The Brain →</span>
    </a>
    <nav aria-label="Main">
      <a href="#dzis">Today</a>
      <a href="#rynek">Market</a>
      <a href="https://www.youtube.com/@erl.grey83/shorts" target="_blank" rel="noopener">Videos</a>
      <a href="#ksiazka">Book</a>
    </nav>
  </header>
  <div class="hero-in">
    <h1>On your path, other people's maps won't work</h1>
    <p>Crypto, gold and awareness. Pure information, every day. Not financial advice.</p>
    <a class="cta" href="#dzis">See what Hexa points to</a>
  </div>
</section>

<section id="rynek" class="strip" aria-label="Live prices">
  <div class="wrap" id="ticks">
    <div class="q au"><span class="s">XAU</span><span class="p">…</span><span class="c"></span></div>
    <div class="q"><span class="s">BTC</span><span class="p">…</span><span class="c"></span></div>
    <div class="q"><span class="s">ETH</span><span class="p">…</span><span class="c"></span></div>
    <div class="q"><span class="s">XRP</span><span class="p">…</span><span class="c"></span></div>
  </div>
</section>

<section id="dzis" class="wrap dzis">
  <div class="l">
    <div class="eyebrow">Hexa points out</div>
    <h2>Three things worth knowing today</h2>
    <div class="neon"></div>
    <div class="upd" id="upd">Loading data…</div>
  </div>
  <div class="r" id="briefTxt">
    <article><div class="n">1</div><div><h3>Bitcoin</h3><p>Loading…</p></div></article>
    <article><div class="n">2</div><div><h3>Gold</h3><p>Loading…</p></div></article>
    <article><div class="n">3</div><div><h3>Altcoins</h3><p>Loading…</p></div></article>
  </div>
</section>

<section class="pyt" id="pytanie">
  <div>
    <span class="eyebrow">Question of the day</span>
    <p id="pyt">Whose map are you following today?</p>
  </div>
</section>

<footer class="wrap" id="ksiazka">
  <div class="b">ERL.GREY83</div>
  <div class="t">Facts, not financial advice · <a href="https://www.instagram.com/erl.grey83/" target="_blank" rel="noopener">Instagram</a> · <a href="https://www.youtube.com/@erl.grey83" target="_blank" rel="noopener">YouTube</a> · <a href="/brain/">How our AI system works</a> · Book on the way</div>
</footer>

<script>
const A=[["pax-gold","XAU"],["bitcoin","BTC"],["ethereum","ETH"],["ripple","XRP"],["solana","SOL"]];
const f=v=>v>=1000?v.toLocaleString('en-US',{maximumFractionDigits:0}):v.toLocaleString('en-US',{maximumFractionDigits:v<10?3:2});
const pc=v=>(v>=0?"+":"")+v.toFixed(1)+"%";
const $=i=>document.getElementById(i);
async function get(){
  const r=await fetch("https://api.coingecko.com/api/v3/coins/markets?vs_currency=usd&ids="+A.map(a=>a[0]).join(",")+"&sparkline=true&price_change_percentage=24h");
  if(!r.ok)throw 0;const d={};
  for(const x of await r.json()){const sp=x.sparkline_in_7d?.price||[];d[x.id]={usd:x.current_price,ch:x.price_change_percentage_24h??0,hi:x.high_24h,lo:x.low_24h,wk:sp.length>1?(sp[sp.length-1]/sp[0]-1)*100:null}}
  if(!d.bitcoin)throw 0;return d}
const art=(n,h,p)=>`<article><div class="n">${n}</div><div><h3>${h}</h3><p>${p}</p></div></article>`;
const dir=c=>c<=-3?"clearly down":c<-.3?"slightly down":c<=.3?"flat":c<3?"slightly up":"clearly up";
const wk=x=>x.wk===null?"":` Over the week: <b>${pc(x.wk)}</b>.`;
const rng=x=>x.hi&&x.lo?` 24h range: $${f(x.lo)} – $${f(x.hi)}.`:"";
async function load(){
  try{
    const d=await get();
    document.querySelectorAll("#ticks .q").forEach((el,i)=>{const x=d[A[i][0]];if(!x)return;el.querySelector(".p").textContent="$"+f(x.usd);const c=el.querySelector(".c");c.textContent=pc(x.ch);c.className="c "+(x.ch>=0?"up":"dn")});
    const b=d.bitcoin,g=d["pax-gold"],al=[["ETH",d.ethereum],["XRP",d.ripple],["SOL",d.solana]].filter(a=>a[1]);
    const avg=al.reduce((a,c)=>a+c[1].ch,0)/(al.length||1);
    const top=[...al].sort((a,c)=>Math.abs(c[1].ch)-Math.abs(a[1].ch))[0];
    let h="";
    h+=art(1,`Bitcoin ${dir(b.ch)}: $${f(b.usd)}`,`24h change: <b>${pc(b.ch)}</b>.${rng(b)}${wk(b)} Source: CoinGecko.`);
    if(g)h+=art(2,`Gold ${dir(g.ch)}: $${f(g.usd)} per ounce`,`24h change: <b>${pc(g.ch)}</b>.${wk(g)} Price from the PAXG token, which tracks one ounce of gold. Source: CoinGecko.`);
    if(top)h+=art(3,`Altcoins ${pc(avg)} on average`,`${al.map(a=>`${a[0]} <b>${pc(a[1].ch)}</b>`).join(", ")}. Biggest mover today: ${top[0]}. ${Math.abs(avg)>Math.abs(b.ch)?"A bigger move than bitcoin.":"A smaller move than bitcoin."} Source: CoinGecko.`);
    $("briefTxt").innerHTML=h;
    $("upd").textContent="Updated "+new Date().toLocaleTimeString("en-GB",{hour:"2-digit",minute:"2-digit"})+" · refreshes every minute";
  }catch(e){$("upd").textContent="Could not load prices – retrying in a minute.";}
}
load();setInterval(load,60000);
// question of the day – one per day, no answer
const Q=["Whose map are you following today?","When you look at a chart, do you see the price or yourself?","How much of what you know about the market have you checked yourself?","If no one were watching, would you make the same decision?","What are you looking for in the market that you haven't found elsewhere?","How do you know this thought is yours and not someone else's?","What do you do when the market is silent?","How much is enough for you?","Does a loss teach you more than a gain?","What remains when you turn off the screen?","What are you looking at when you say you're watching the market?","Who chose the direction you're walking in?","What would you see if you looked from a different angle?","Is waiting an action for you?"];
$("pyt").textContent=Q[Math.floor(Date.now()/864e5)%Q.length];
// calm section reveal
if(!matchMedia("(prefers-reduced-motion: reduce)").matches&&"IntersectionObserver" in window){const els=[...document.querySelectorAll(".dzis .l,.dzis .r,.pyt div")];els.forEach(e=>e.classList.add("rv"));const io=new IntersectionObserver(es=>es.forEach(x=>{if(x.isIntersecting){x.target.classList.add("in");io.unobserve(x.target)}}),{threshold:.1});els.forEach(e=>io.observe(e))}
</script>
</body>
</html>
